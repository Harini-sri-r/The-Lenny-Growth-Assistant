APP_NAME=Lenny Growth Assistant
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://example_user:example_password@localhost:5432/example_db
POSTGRES_DB=lenny
POSTGRES_USER=lenny
POSTGRES_PASSWORD=replace_with_a_long_random_password
BACKEND_PORT=8000
FRONTEND_PORT=5173
CHROMA_HOST_PATH=./chroma
TRANSCRIPTS_PATH=./lennys-newsletterpodcastdata-main
CHROMA_PERSIST_DIRECTORY=./chroma
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_COLLECTION_NAME=lenny_transcripts
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
EMBEDDING_BATCH_SIZE=8
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
LLM_TIMEOUT_SECONDS=90
OLLAMA_GENERATION_TIMEOUT_SECONDS=240
SHIP30_GENERATION_TIMEOUT_SECONDS=180
SHIP30_MAX_OUTPUT_TOKENS=3000
SHIP30_MINIMUM_RESPONSE_WORDS=1000
SHIP30_MAX_CONTINUATIONS=3
LLM_PROVIDER=ollama
AGENT_FRAMEWORK=rag_service
PI_COMMAND=pi
PI_TIMEOUT_SECONDS=240
PI_SHIP30_TIMEOUT_SECONDS=900
CLAUDE_AGENT_MODEL=sonnet
CLAUDE_AGENT_MAX_TURNS=5
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
